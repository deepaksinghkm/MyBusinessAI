import { useEffect, useMemo, useState } from "react";

import {
  Alert,
  Autocomplete,
  Box,
  Button,
  Card,
  CardContent,
  Divider,
  MenuItem,
  Snackbar,
  TextField,
  Typography,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
} from "@mui/material";

import AddShoppingCartIcon from "@mui/icons-material/AddShoppingCart";
import SaveIcon from "@mui/icons-material/Save";
import PrintIcon from "@mui/icons-material/Print";
import VisibilityIcon from "@mui/icons-material/Visibility";
import CloseIcon from "@mui/icons-material/Close";

import { createSale, getSales } from "../../api/salesApi";

const API_BASE_URL = "http://127.0.0.1:8000";

const EMPTY_ITEM = {
  product_id: "",
  variant_id: "",
  qty: 1,
  rate: "",
  discount_percent: 0,
  tax_percent: 0,
};

export default function SalesPage() {
  // =====================================================
  // MASTER DATA
  // =====================================================

  const [customers, setCustomers] = useState([]);
  const [company, setCompany] = useState(null);
  const [products, setProducts] = useState([]);
  const [variants, setVariants] = useState([]);
  const [colors, setColors] = useState([]);
  const [sizes, setSizes] = useState([]);

  // =====================================================
  // CUSTOMER
  // =====================================================

  const [billToCustomer, setBillToCustomer] =
    useState(null);

  const [shipToCustomer, setShipToCustomer] =
    useState(null);

  // =====================================================
  // SALE DETAILS
  // =====================================================

  const [saleDate, setSaleDate] = useState(
    new Date().toISOString().split("T")[0]
  );

  // Editable invoice number. After saving, the next number
  // is generated automatically from the saved invoice number.
  const [invoiceNo, setInvoiceNo] = useState("INV-0001");

  const [taxType, setTaxType] =
    useState("GST");

  const [taxPercent, setTaxPercent] =
    useState(18);

  // =====================================================
  // ITEM
  // =====================================================

  const [item, setItem] = useState({
    ...EMPTY_ITEM,
  });

  const [items, setItems] = useState([]);

  // =====================================================
  // INVOICE PREVIEW
  // =====================================================

  const [invoiceOpen, setInvoiceOpen] =
    useState(false);

  const [savedInvoice, setSavedInvoice] =
    useState(null);

  // =====================================================
  // STATUS
  // =====================================================

  const [saving, setSaving] =
    useState(false);

  const [error, setError] =
    useState("");

  const [success, setSuccess] =
    useState("");

  // =====================================================
  // INVOICE NUMBER HELPERS
  // =====================================================

  const getNextInvoiceNumber = (
    invoiceNumbers = [],
    fallbackPrefix = "INV",
    fallbackNumber = 1
  ) => {
    let highestNumber = 0;
    let highestPrefix =
      fallbackPrefix || "INV";

    if (
      highestPrefix &&
      !/[\-\/_]$/.test(highestPrefix)
    ) {
      highestPrefix = `${highestPrefix}-`;
    }

    let highestWidth = 4;

    invoiceNumbers.forEach((value) => {
      const raw = String(value || "").trim();

      if (!raw) {
        return;
      }

      const match = raw.match(/^(.*?)(\d+)$/);

      if (!match) {
        return;
      }

      const number = Number(match[2]);

      if (!Number.isFinite(number)) {
        return;
      }

      if (number > highestNumber) {
        highestNumber = number;
        highestPrefix = match[1] || fallbackPrefix || "INV";
        highestWidth = Math.max(
          match[2].length,
          1
        );
      }
    });

    const nextNumber =
      highestNumber > 0
        ? highestNumber + 1
        : Number(fallbackNumber) || 1;

    return `${highestPrefix}${String(
      nextNumber
    ).padStart(highestWidth, "0")}`;
  };

  const getNextInvoiceFromCurrent = (
    currentValue
  ) => {
    const raw = String(
      currentValue || ""
    ).trim();

    const match =
      raw.match(/^(.*?)(\d+)$/);

    if (!match) {
      return getNextInvoiceNumber(
        [],
        company?.invoice_prefix || "INV",
        1
      );
    }

    const prefix =
      match[1] ||
      company?.invoice_prefix ||
      "INV";

    const currentNumber =
      Number(match[2]) || 0;

    const nextNumber =
      currentNumber + 1;

    return `${prefix}${String(
      nextNumber
    ).padStart(
      Math.max(match[2].length, 1),
      "0"
    )}`;
  };

  const loadNextInvoiceNumber = async (
    invoicePrefix
  ) => {
    try {
      const sales = await getSales();

      const invoiceNumbers = sales
        .map(
          (sale) =>
            sale.invoice_no
        )
        .filter(Boolean);

      const prefix =
        invoicePrefix ||
        company?.invoice_prefix ||
        "INV";

      setInvoiceNo(
        getNextInvoiceNumber(
          invoiceNumbers,
          prefix,
          1
        )
      );
    } catch (err) {
      console.error(
        "INVOICE NUMBER LOAD ERROR:",
        err
      );

      setInvoiceNo(
        `INV-${String(1).padStart(
          4,
          "0"
        )}`
      );
    }
  };

  // =====================================================
  // LOAD MASTER DATA
  // =====================================================

  useEffect(() => {
    loadMasterData();
  }, []);

  const loadMasterData = async () => {
    try {
      const [
        customersResponse,
        companiesResponse,
        productsResponse,
        variantsResponse,
        colorsResponse,
        sizesResponse,
      ] = await Promise.all([
        fetch(`${API_BASE_URL}/customers/`),
        fetch(`${API_BASE_URL}/companies/`),
        fetch(`${API_BASE_URL}/products/`),
        fetch(`${API_BASE_URL}/product-variants/`),
        fetch(`${API_BASE_URL}/colors/`),
        fetch(`${API_BASE_URL}/sizes/`),
      ]);

      const customersData =
        await customersResponse.json();

      const companiesData =
        await companiesResponse.json();

      const productsData =
        await productsResponse.json();

      const variantsData =
        await variantsResponse.json();

      const colorsData =
        await colorsResponse.json();

      const sizesData =
        await sizesResponse.json();

      if (!customersResponse.ok) {
        throw new Error(
          customersData.detail ||
            "Failed to load customers"
        );
      }

      if (!companiesResponse.ok) {
        throw new Error(
          companiesData.detail ||
            "Failed to load company"
        );
      }

      if (!productsResponse.ok) {
        throw new Error(
          productsData.detail ||
            "Failed to load products"
        );
      }

      if (!variantsResponse.ok) {
        throw new Error(
          variantsData.detail ||
            "Failed to load variants"
        );
      }

      if (!colorsResponse.ok) {
        throw new Error(
          colorsData.detail ||
            "Failed to load colors"
        );
      }

      if (!sizesResponse.ok) {
        throw new Error(
          sizesData.detail ||
            "Failed to load sizes"
        );
      }

      setCustomers(
        Array.isArray(customersData)
          ? customersData
          : []
      );

      setCompany(
        Array.isArray(companiesData)
          ? companiesData[0] || null
          : companiesData || null
      );

      setProducts(
        Array.isArray(productsData)
          ? productsData
          : []
      );

      setVariants(
        Array.isArray(variantsData)
          ? variantsData
          : []
      );

      setColors(
        Array.isArray(colorsData)
          ? colorsData
          : []
      );

      setSizes(
        Array.isArray(sizesData)
          ? sizesData
          : []
      );

      const loadedCompany =
        Array.isArray(companiesData)
          ? companiesData[0] || null
          : companiesData || null;

      await loadNextInvoiceNumber(
        loadedCompany?.invoice_prefix ||
          "INV"
      );
    } catch (err) {
      console.error(err);

      setError(
        err.message ||
          "Failed to load master data"
      );
    }
  };

  // =====================================================
  // CUSTOMER ADDRESS
  // =====================================================

  const getCustomerAddress = (customer) => {
    if (!customer) {
      return "-";
    }

    const parts = [
      customer.address1,
      customer.address2,
      customer.city,
      customer.state,
      customer.country,
      customer.pincode,
    ].filter(Boolean);

    return parts.length
      ? parts.join(", ")
      : "-";
  };

  // =====================================================
  // PRODUCT VARIANTS
  // =====================================================

  const productVariants = useMemo(() => {
    if (!item.product_id) {
      return [];
    }

    return variants.filter(
      (variant) =>
        Number(variant.product_id) ===
        Number(item.product_id)
    );
  }, [
    variants,
    item.product_id,
  ]);

  // =====================================================
  // SELECTED PRODUCT
  // =====================================================

  const selectedProduct = useMemo(() => {
    return products.find(
      (product) =>
        Number(product.id) ===
        Number(item.product_id)
    );
  }, [
    products,
    item.product_id,
  ]);

  // =====================================================
  // SELECTED VARIANT
  // =====================================================

  const selectedVariant = useMemo(() => {
    return variants.find(
      (variant) =>
        Number(variant.id) ===
        Number(item.variant_id)
    );
  }, [
    variants,
    item.variant_id,
  ]);

  // =====================================================
  // ITEM CALCULATION
  // =====================================================

  const calculateItem = () => {
    const qty =
      Number(item.qty) || 0;

    const rate =
      Number(item.rate) || 0;

    const discountPercent =
      Number(
        item.discount_percent
      ) || 0;

    const tax =
      Number(item.tax_percent) || 0;

    const gross =
      qty * rate;

    const discountAmount =
      gross *
      discountPercent /
      100;

    const taxableAmount =
      Math.max(
        gross - discountAmount,
        0
      );

    const taxAmount =
      taxableAmount *
      tax /
      100;

    const finalAmount =
      taxableAmount +
      taxAmount;

    return {
      gross,
      discountAmount,
      taxableAmount,
      taxAmount,
      finalAmount,
    };
  };

  // =====================================================
  // ADD ITEM
  // =====================================================

  const handleAddItem = () => {
    if (!item.product_id) {
      setError(
        "Please select Product."
      );
      return;
    }

    if (!item.variant_id) {
      setError(
        "Please select Variant."
      );
      return;
    }

    if (
      !item.qty ||
      Number(item.qty) <= 0
    ) {
      setError(
        "Quantity must be greater than zero."
      );
      return;
    }

    if (
      selectedVariant &&
      Number(item.qty) >
        Number(
          selectedVariant.stock || 0
        )
    ) {
      setError(
        `Insufficient stock. Available stock: ${
          selectedVariant.stock || 0
        }`
      );
      return;
    }

    if (
      item.rate === "" ||
      Number(item.rate) < 0
    ) {
      setError(
        "Please enter a valid rate."
      );
      return;
    }

    const color =
      colors.find(
        (value) =>
          Number(value.id) ===
          Number(
            selectedVariant.color_id
          )
      );

    const size =
      sizes.find(
        (value) =>
          Number(value.id) ===
          Number(
            selectedVariant.size_id
          )
      );

    const calculation =
      calculateItem();

    const newItem = {
      product_id:
        item.product_id,

      variant_id:
        item.variant_id,

      qty:
        Number(item.qty),

      rate:
        Number(item.rate),

      discount_percent:
        Number(
          item.discount_percent
        ) || 0,

      discount_amount:
        calculation.discountAmount,

      tax_percent:
        Number(item.tax_percent) ||
        0,

      tax_amount:
        calculation.taxAmount,

      product_name:
        selectedProduct?.name ||
        selectedProduct?.product_name ||
        "-",

      sku:
        selectedProduct?.sku ||
        selectedProduct?.product_code ||
        "-",

      color_name:
        color?.name || "-",

      size_name:
        size?.name || "-",

      stock:
        selectedVariant?.stock || 0,

      taxable_amount:
        calculation.taxableAmount,

      amount:
        calculation.finalAmount,
    };

    setItems((previous) => [
      ...previous,
      newItem,
    ]);

    setItem({
      ...EMPTY_ITEM,
      tax_percent:
        Number(taxPercent) || 0,
    });
  };

  // =====================================================
  // REMOVE ITEM
  // =====================================================

  const handleRemoveItem = (
    index
  ) => {
    setItems((previous) =>
      previous.filter(
        (_, itemIndex) =>
          itemIndex !== index
      )
    );
  };

  // =====================================================
  // TOTALS
  // =====================================================

  const subtotal = items.reduce(
    (total, currentItem) =>
      total +
      Number(
        currentItem.taxable_amount ||
          0
      ),
    0
  );

  const totalDiscount =
    items.reduce(
      (total, currentItem) =>
        total +
        Number(
          currentItem.discount_amount ||
            0
        ),
      0
    );

  const totalTax =
    items.reduce(
      (total, currentItem) =>
        total +
        Number(
          currentItem.tax_amount ||
            0
        ),
      0
    );

  const grandTotal =
    subtotal + totalTax;

  // =====================================================
  // SAVE SALE
  // =====================================================

  const handleSaveSale = async () => {
    if (!billToCustomer) {
      setError(
        "Please select Bill To customer."
      );
      return;
    }

    if (!shipToCustomer) {
      setError(
        "Please select Ship To customer."
      );
      return;
    }

    if (items.length === 0) {
      setError(
        "Please add at least one item."
      );
      return;
    }

    const cleanInvoiceNo =
      String(invoiceNo || "").trim();

    if (!cleanInvoiceNo) {
      setError(
        "Please enter an invoice number."
      );
      return;
    }

    if (!/\d+$/.test(cleanInvoiceNo)) {
      setError(
        "Invoice number must end with a number, for example INV-0001 or 500."
      );
      return;
    }

    try {
      setSaving(true);

      const saleNo =
        `SAL-${Date.now()}`;

      const payload = {
        sale_no: saleNo,

        sale_date: saleDate,

        // Customer Master IDs
        bill_to_customer_id:
          billToCustomer?.id || null,

        ship_to_customer_id:
          shipToCustomer?.id || null,

        customer_name:
          billToCustomer.customer_name,

        customer_mobile:
          billToCustomer.mobile ||
          null,

        invoice_no:
          cleanInvoiceNo,

        remarks:
          `Bill To: ${
            billToCustomer.customer_name
          } | Ship To: ${
            shipToCustomer.customer_name
          } | Tax: ${taxType} ${
            Number(taxPercent)
          }%`,

        // Backend expects discount amount.
        // Item discount is already calculated
        // as amount, so sale-level discount = 0.
        discount: 0,

        // Send the total item tax to the backend.
        tax: Number(totalTax.toFixed(2)),

        items: items.map(
          (currentItem) => ({
            variant_id:
              Number(
                currentItem.variant_id
              ),

            qty:
              Number(
                currentItem.qty
              ),

            rate:
              Number(
                currentItem.rate
              ),

            discount:
              Number(
                currentItem.discount_amount ||
                  0
              ),

            tax_percent:
              Number(
                currentItem.tax_percent ||
                  0
              ),
          })
        ),
      };

      console.log(
        "SALE PAYLOAD:",
        payload
      );

      const result =
        await createSale(
          payload
        );

      console.log(
        "SALE RESPONSE:",
        result
      );

      // Keep a complete local snapshot for invoice preview.
      setSavedInvoice({
        ...result,
        company: company || null,
        bill_to_customer: billToCustomer,
        ship_to_customer: shipToCustomer,
        tax_type: taxType,
        tax_percent: Number(taxPercent) || 0,
        items: items.map((currentItem) => ({
          ...currentItem,
        })),
      });

      // Prepare the next invoice number immediately.
      // Example: INV-0007 -> INV-0008
      //          500      -> 501
      const savedInvoiceNumber =
        String(
          result.invoice_no ||
            cleanInvoiceNo
        ).trim();

      setInvoiceNo(
        getNextInvoiceFromCurrent(
          savedInvoiceNumber
        )
      );

      setInvoiceOpen(true);

      setSuccess(
        `Sale ${
          result.sale_no
        } saved successfully. Invoice ${
          result.invoice_no ||
          invoiceNo
        } saved.`
      );

      setItems([]);

      setBillToCustomer(null);
      setShipToCustomer(null);

      setItem({
        ...EMPTY_ITEM,
        tax_percent:
          Number(taxPercent) || 0,
      });

      await loadMasterData();
    } catch (err) {
      console.error(
        "SALE SAVE ERROR:",
        err
      );

      setError(
        err.message ||
          "Unable to save sale."
      );
    } finally {
      setSaving(false);
    }
  };

  // =====================================================
  // INVOICE HELPERS
  // =====================================================

  const formatMoney = (value) =>
    Number(value || 0).toLocaleString(
      "en-IN",
      {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      }
    );

  const escapeHtml = (value) =>
    String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");

  const printInvoice = () => {
    if (!savedInvoice) {
      return;
    }

    const invoice = savedInvoice;
    const invoiceCompany =
      invoice.company || {};

    const billTo =
      invoice.bill_to_customer || {};

    const shipTo =
      invoice.ship_to_customer || {};

    const invoiceItems =
      Array.isArray(invoice.items)
        ? invoice.items
        : [];

    const rows = invoiceItems
      .map(
        (invoiceItem, index) => `
          <tr>
            <td>${index + 1}</td>
            <td>
              <strong>${escapeHtml(
                invoiceItem.product_name || "-"
              )}</strong><br>
              <span class="muted">
                SKU: ${escapeHtml(
                  invoiceItem.sku || "-"
                )}
                &nbsp; | &nbsp;
                ${escapeHtml(
                  invoiceItem.color_name || "-"
                )}
                / ${escapeHtml(
                  invoiceItem.size_name || "-"
                )}
              </span>
            </td>
            <td class="right">
              ${Number(invoiceItem.qty || 0)}
            </td>
            <td class="right">
              ₹${formatMoney(invoiceItem.rate)}
            </td>
            <td class="right">
              ${formatMoney(
                invoiceItem.discount_percent
              )}%
            </td>
            <td class="right">
              ₹${formatMoney(
                invoiceItem.discount_amount
              )}
            </td>
            <td class="right">
              ${formatMoney(
                invoiceItem.tax_percent
              )}%
            </td>
            <td class="right">
              ₹${formatMoney(
                invoiceItem.amount
              )}
            </td>
          </tr>
        `
      )
      .join("");

    const totalTax =
      Number(invoice.tax || 0);

    const taxPercentValue =
      Number(invoice.tax_percent || 0);

    let taxLabel =
      `${invoice.tax_type || "GST"} ${taxPercentValue}%`;

    if (
      invoice.tax_type === "CGST + SGST"
    ) {
      const halfTax =
        totalTax / 2;

      taxLabel =
        `CGST ${(
          taxPercentValue / 2
        ).toFixed(2)}% + SGST ${(
          taxPercentValue / 2
        ).toFixed(2)}%`;
    }

    const billAddress =
      getCustomerAddress(billTo);

    const shipAddress =
      getCustomerAddress(shipTo);

    const invoiceWindow =
      window.open(
        "",
        "_blank",
        "width=1200,height=900"
      );

    if (!invoiceWindow) {
      setError(
        "Please allow pop-ups to print the invoice."
      );
      return;
    }

    invoiceWindow.document.write(`
      <!DOCTYPE html>
      <html>
      <head>
        <title>Invoice ${
          escapeHtml(invoice.sale_no)
        }</title>

        <style>
          * {
            box-sizing: border-box;
          }

          body {
            margin: 0;
            padding: 24px;
            font-family: Arial, Helvetica, sans-serif;
            color: #111827;
            background: #f3f4f6;
          }

          .invoice {
            max-width: 1100px;
            margin: auto;
            background: white;
            padding: 32px;
          }

          .header {
            display: flex;
            justify-content: space-between;
            gap: 24px;
            border-bottom: 2px solid #111827;
            padding-bottom: 18px;
          }

          .company {
            flex: 1;
          }

          .logo {
            max-width: 120px;
            max-height: 70px;
            object-fit: contain;
            margin-bottom: 8px;
          }

          .company-name {
            font-size: 24px;
            font-weight: 700;
            margin-bottom: 6px;
          }

          .small {
            font-size: 12px;
            line-height: 1.5;
          }

          .invoice-title {
            text-align: right;
          }

          .invoice-title h1 {
            margin: 0 0 8px;
            font-size: 30px;
          }

          .meta {
            font-size: 13px;
            line-height: 1.7;
          }

          .parties {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin: 24px 0;
          }

          .box {
            border: 1px solid #d1d5db;
            padding: 14px;
            border-radius: 4px;
          }

          .box-title {
            font-weight: 700;
            font-size: 13px;
            text-transform: uppercase;
            margin-bottom: 8px;
          }

          table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 16px;
          }

          th,
          td {
            border: 1px solid #d1d5db;
            padding: 9px;
            font-size: 12px;
            vertical-align: top;
          }

          th {
            background: #f3f4f6;
            font-weight: 700;
            text-align: left;
          }

          .right {
            text-align: right;
          }

          .muted {
            color: #6b7280;
            font-size: 10px;
          }

          .bottom {
            display: grid;
            grid-template-columns: 1fr 360px;
            gap: 24px;
            margin-top: 24px;
          }

          .summary {
            width: 100%;
          }

          .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            font-size: 13px;
          }

          .grand {
            border-top: 2px solid #111827;
            margin-top: 8px;
            padding-top: 10px;
            font-size: 18px;
            font-weight: 700;
          }

          .footer {
            margin-top: 36px;
            padding-top: 14px;
            border-top: 1px solid #d1d5db;
            font-size: 11px;
            color: #4b5563;
          }

          @media print {
            body {
              padding: 0;
              background: white;
            }

            .invoice {
              max-width: none;
              padding: 12mm;
            }

            .no-print {
              display: none !important;
            }
          }
        </style>
      </head>

      <body>
        <div class="invoice">

          <div class="header">

            <div class="company">

              ${
                invoiceCompany.logo
                  ? `<img
                      class="logo"
                      src="${escapeHtml(
                        invoiceCompany.logo.startsWith("http")
                          ? invoiceCompany.logo
                          : `${API_BASE_URL}/${invoiceCompany.logo.replace(/^\//, "")}`
                      )}"
                    />`
                  : ""
              }

              <div class="company-name">
                ${escapeHtml(
                  invoiceCompany.company_name ||
                    "MyBusinessAI"
                )}
              </div>

              <div class="small">
                ${escapeHtml(
                  invoiceCompany.legal_name || ""
                )}
              </div>

              <div class="small">
                ${escapeHtml(
                  [
                    invoiceCompany.address1,
                    invoiceCompany.address2,
                    invoiceCompany.city,
                    invoiceCompany.state,
                    invoiceCompany.pincode,
                    invoiceCompany.country,
                  ]
                    .filter(Boolean)
                    .join(", ")
                )}
              </div>

              ${
                invoiceCompany.gst_no
                  ? `<div class="small">
                      <strong>GSTIN:</strong>
                      ${escapeHtml(
                        invoiceCompany.gst_no
                      )}
                    </div>`
                  : ""
              }

              ${
                invoiceCompany.pan_no
                  ? `<div class="small">
                      <strong>PAN:</strong>
                      ${escapeHtml(
                        invoiceCompany.pan_no
                      )}
                    </div>`
                  : ""
              }

              ${
                invoiceCompany.mobile ||
                invoiceCompany.phone ||
                invoiceCompany.email
                  ? `<div class="small">
                      ${escapeHtml(
                        [
                          invoiceCompany.mobile ||
                            invoiceCompany.phone,
                          invoiceCompany.email,
                          invoiceCompany.website,
                        ]
                          .filter(Boolean)
                          .join(" | ")
                      )}
                    </div>`
                  : ""
              }

            </div>

            <div class="invoice-title">
              <h1>TAX INVOICE</h1>

              <div class="meta">
                <strong>Invoice No:</strong>
                ${escapeHtml(
                  invoice.sale_no
                )}
                <br>

                <strong>Invoice Date:</strong>
                ${escapeHtml(
                  invoice.sale_date
                )}
                <br>

                <strong>Tax:</strong>
                ${escapeHtml(
                  taxLabel
                )}
              </div>
            </div>

          </div>


          <div class="parties">

            <div class="box">
              <div class="box-title">
                Bill To
              </div>

              <strong>
                ${escapeHtml(
                  billTo.customer_name ||
                    invoice.customer_name ||
                    "-"
                )}
              </strong>

              ${
                billTo.customer_code
                  ? `<div class="small">
                      Code:
                      ${escapeHtml(
                        billTo.customer_code
                      )}
                    </div>`
                  : ""
              }

              ${
                billTo.gst_no
                  ? `<div class="small">
                      GSTIN:
                      ${escapeHtml(
                        billTo.gst_no
                      )}
                    </div>`
                  : ""
              }

              <div class="small">
                ${escapeHtml(
                  billAddress
                )}
              </div>

              ${
                billTo.mobile
                  ? `<div class="small">
                      Mobile:
                      ${escapeHtml(
                        billTo.mobile
                      )}
                    </div>`
                  : ""
              }
            </div>


            <div class="box">
              <div class="box-title">
                Ship To
              </div>

              <strong>
                ${escapeHtml(
                  shipTo.customer_name ||
                    "-"
                )}
              </strong>

              ${
                shipTo.gst_no
                  ? `<div class="small">
                      GSTIN:
                      ${escapeHtml(
                        shipTo.gst_no
                      )}
                    </div>`
                  : ""
              }

              <div class="small">
                ${escapeHtml(
                  shipAddress
                )}
              </div>

              ${
                shipTo.mobile
                  ? `<div class="small">
                      Mobile:
                      ${escapeHtml(
                        shipTo.mobile
                      )}
                    </div>`
                  : ""
              }
            </div>

          </div>


          <table>

            <thead>
              <tr>
                <th>#</th>
                <th>Product</th>
                <th class="right">Qty</th>
                <th class="right">Rate</th>
                <th class="right">Disc %</th>
                <th class="right">Discount</th>
                <th class="right">Tax %</th>
                <th class="right">Amount</th>
              </tr>
            </thead>

            <tbody>
              ${rows}
            </tbody>

          </table>


          <div class="bottom">

            <div>

              ${
                invoice.remarks
                  ? `<div class="box">
                      <div class="box-title">
                        Remarks
                      </div>
                      <div class="small">
                        ${escapeHtml(
                          invoice.remarks
                        )}
                      </div>
                    </div>`
                  : ""
              }

              ${
                invoiceCompany.terms_conditions
                  ? `<div class="box" style="margin-top:12px">
                      <div class="box-title">
                        Terms & Conditions
                      </div>
                      <div class="small">
                        ${escapeHtml(
                          invoiceCompany.terms_conditions
                        )}
                      </div>
                    </div>`
                  : ""
              }

            </div>


            <div class="summary">

              <div class="summary-row">
                <span>Subtotal</span>
                <strong>
                  ₹${formatMoney(
                    invoice.subtotal
                  )}
                </strong>
              </div>

              <div class="summary-row">
                <span>Discount</span>
                <strong>
                  ₹${formatMoney(
                    invoice.discount
                  )}
                </strong>
              </div>

              <div class="summary-row">
                <span>
                  ${escapeHtml(
                    taxLabel
                  )}
                </span>
                <strong>
                  ₹${formatMoney(
                    invoice.tax
                  )}
                </strong>
              </div>

              <div class="summary-row grand">
                <span>Grand Total</span>
                <span>
                  ₹${formatMoney(
                    invoice.grand_total
                  )}
                </span>
              </div>

            </div>

          </div>


          ${
            invoiceCompany.invoice_footer
              ? `<div class="footer">
                  ${escapeHtml(
                    invoiceCompany.invoice_footer
                  )}
                </div>`
              : ""
          }

          <div class="footer">
            This is a computer generated invoice.
          </div>

        </div>

        <script>
          window.onload = function () {
            window.focus();
          };
        </script>
      </body>
      </html>
    `);

    invoiceWindow.document.close();
    invoiceWindow.focus();
  };

  // =====================================================
  // RENDER
  // =====================================================

  return (
    <Box
      sx={{
        width: "100%",
        p: 2,
      }}
    >
      {/* HEADER */}

      <Typography
        variant="h5"
        fontWeight={700}
        sx={{ mb: 0.5 }}
      >
        Sales
      </Typography>

      <Typography
        variant="body2"
        color="text.secondary"
        sx={{ mb: 3 }}
      >
        Create sales invoice and
        manage stock deduction.
      </Typography>

      {savedInvoice && (
        <Button
          variant="outlined"
          startIcon={<VisibilityIcon />}
          onClick={() =>
            setInvoiceOpen(true)
          }
          sx={{ mb: 2 }}
        >
          View Last Invoice
        </Button>
      )}

      {/* =================================================
          SALE + CUSTOMER DETAILS
      ================================================= */}

      <Card sx={{ mb: 2 }}>
        <CardContent>
          <Typography
            variant="h6"
            fontWeight={700}
            sx={{ mb: 2 }}
          >
            Sale Details
          </Typography>

          <Box
            sx={{
              display: "grid",
              gridTemplateColumns: {
                xs: "1fr",
                md: "1fr 1.2fr 1.2fr 1.2fr",
              },
              gap: 2,
            }}
          >
            <TextField
              fullWidth
              type="date"
              label="Sale Date"
              value={saleDate}
              onChange={(event) =>
                setSaleDate(
                  event.target.value
                )
              }
              InputLabelProps={{
                shrink: true,
              }}
            />

            {/* INVOICE NUMBER */}

            <TextField
              fullWidth
              label="Invoice Number"
              value={invoiceNo}
              onChange={(event) =>
                setInvoiceNo(
                  event.target.value
                )
              }
              helperText="Editable. After save, the next number is generated automatically."
              placeholder="INV-0001"
            />

            {/* BILL TO */}

            <Autocomplete
              fullWidth
              options={customers}
              value={billToCustomer}
              onChange={(
                _event,
                newValue
              ) => {
                setBillToCustomer(
                  newValue
                );

                if (
                  newValue &&
                  !shipToCustomer
                ) {
                  setShipToCustomer(
                    newValue
                  );
                }
              }}
              getOptionLabel={(
                customer
              ) =>
                customer
                  ? `${customer.customer_code} - ${customer.customer_name}`
                  : ""
              }
              isOptionEqualToValue={(
                option,
                value
              ) =>
                Number(option.id) ===
                Number(value.id)
              }
              renderInput={(params) => (
                <TextField
                  {...params}
                  label="Bill To Customer"
                  placeholder="Search customer..."
                />
              )}
            />

            {/* SHIP TO */}

            <Autocomplete
              fullWidth
              options={customers}
              value={shipToCustomer}
              onChange={(
                _event,
                newValue
              ) =>
                setShipToCustomer(
                  newValue
                )
              }
              getOptionLabel={(
                customer
              ) =>
                customer
                  ? `${customer.customer_code} - ${customer.customer_name}`
                  : ""
              }
              isOptionEqualToValue={(
                option,
                value
              ) =>
                Number(option.id) ===
                Number(value.id)
              }
              renderInput={(params) => (
                <TextField
                  {...params}
                  label="Ship To Customer"
                  placeholder="Search customer..."
                />
              )}
            />

            {/* TAX TYPE */}

            <TextField
              select
              fullWidth
              label="Tax Type"
              value={taxType}
              onChange={(event) => {
                const value =
                  event.target.value;

                setTaxType(value);

                if (
                  value ===
                  "Exempt"
                ) {
                  setTaxPercent(0);
                }
              }}
            >
              <MenuItem value="GST">
                GST
              </MenuItem>

              <MenuItem value="CGST + SGST">
                CGST + SGST
              </MenuItem>

              <MenuItem value="IGST">
                IGST
              </MenuItem>

              <MenuItem value="Exempt">
                Exempt
              </MenuItem>
            </TextField>

            {/* TAX % */}

            <TextField
              fullWidth
              type="number"
              label="Tax %"
              value={taxPercent}
              onChange={(event) => {
                const value =
                  event.target.value;

                setTaxPercent(value);

                setItem(
                  (previous) => ({
                    ...previous,
                    tax_percent:
                      value,
                  })
                );
              }}
              disabled={
                taxType === "Exempt"
              }
              inputProps={{
                min: 0,
                max: 100,
                step: 0.01,
              }}
            />

            {/* CUSTOMER MOBILE */}

            <TextField
              fullWidth
              label="Customer Mobile"
              value={
                billToCustomer?.mobile ||
                ""
              }
              InputProps={{
                readOnly: true,
              }}
            />
          </Box>

          {/* BILL / SHIP ADDRESS */}

          <Box
            sx={{
              display: "grid",
              gridTemplateColumns: {
                xs: "1fr",
                md: "1fr 1fr",
              },
              gap: 2,
              mt: 2,
            }}
          >
            <Box
              sx={{
                border: "1px solid",
                borderColor: "divider",
                borderRadius: 2,
                p: 2,
              }}
            >
              <Typography
                fontWeight={700}
                sx={{ mb: 1 }}
              >
                Bill To
              </Typography>

              <Typography>
                {billToCustomer
                  ?.customer_name ||
                  "-"}
              </Typography>

              <Typography
                variant="body2"
                color="text.secondary"
              >
                GST:{" "}
                {billToCustomer?.gst_no ||
                  "-"}
              </Typography>

              <Typography
                variant="body2"
                color="text.secondary"
              >
                {getCustomerAddress(
                  billToCustomer
                )}
              </Typography>
            </Box>

            <Box
              sx={{
                border: "1px solid",
                borderColor: "divider",
                borderRadius: 2,
                p: 2,
              }}
            >
              <Typography
                fontWeight={700}
                sx={{ mb: 1 }}
              >
                Ship To
              </Typography>

              <Typography>
                {shipToCustomer
                  ?.customer_name ||
                  "-"}
              </Typography>

              <Typography
                variant="body2"
                color="text.secondary"
              >
                GST:{" "}
                {shipToCustomer?.gst_no ||
                  "-"}
              </Typography>

              <Typography
                variant="body2"
                color="text.secondary"
              >
                {getCustomerAddress(
                  shipToCustomer
                )}
              </Typography>
            </Box>
          </Box>
        </CardContent>
      </Card>

      {/* =================================================
          ADD PRODUCT
      ================================================= */}

      <Card sx={{ mb: 2 }}>
        <CardContent>
          <Typography
            variant="h6"
            fontWeight={700}
            sx={{ mb: 2 }}
          >
            Add Product
          </Typography>

          <Box
            sx={{
              display: "grid",
              gridTemplateColumns: {
                xs: "1fr",
                sm: "1fr 1fr",
                lg: "2fr 2fr 1fr",
              },
              gap: 2,
            }}
          >
            {/* PRODUCT */}

            <Autocomplete
              fullWidth
              options={products}
              value={
                selectedProduct || null
              }
              onChange={(
                _event,
                newValue
              ) => {
                setItem({
                  ...EMPTY_ITEM,
                  product_id:
                    newValue?.id || "",
                  tax_percent:
                    Number(
                      taxPercent
                    ) || 0,
                });
              }}
              getOptionLabel={(
                product
              ) =>
                product
                  ? `${
                      product.sku ||
                      product.product_code ||
                      ""
                    } - ${
                      product.name ||
                      product.product_name ||
                      ""
                    }`
                  : ""
              }
              isOptionEqualToValue={(
                option,
                value
              ) =>
                Number(option.id) ===
                Number(value.id)
              }
              renderInput={(params) => (
                <TextField
                  {...params}
                  fullWidth
                  label="Product"
                  placeholder="Search product..."
                />
              )}
            />

            {/* VARIANT */}

            <Autocomplete
              fullWidth
              disabled={
                !item.product_id
              }
              options={productVariants}
              value={
                selectedVariant ||
                null
              }
              onChange={(
                _event,
                newValue
              ) => {
                setItem(
                  (previous) => ({
                    ...previous,
                    variant_id:
                      newValue?.id ||
                      "",
                    rate:
                      selectedProduct?.mrp ??
                      "",
                  })
                );
              }}
              getOptionLabel={(
                variant
              ) => {
                const color =
                  colors.find(
                    (value) =>
                      Number(
                        value.id
                      ) ===
                      Number(
                        variant.color_id
                      )
                  );

                const size =
                  sizes.find(
                    (value) =>
                      Number(
                        value.id
                      ) ===
                      Number(
                        variant.size_id
                      )
                  );

                return `${color?.name || "-"} / ${
                  size?.name || "-"
                } / Stock: ${
                  variant.stock ?? 0
                }`;
              }}
              isOptionEqualToValue={(
                option,
                value
              ) =>
                Number(option.id) ===
                Number(value.id)
              }
              renderInput={(params) => (
                <TextField
                  {...params}
                  fullWidth
                  label="Variant / Color / Size"
                  placeholder="Select variant..."
                />
              )}
            />

            {/* STOCK */}

            <TextField
              fullWidth
              label="Available Stock"
              value={
                selectedVariant?.stock ??
                ""
              }
              InputProps={{
                readOnly: true,
              }}
            />

            {/* QUANTITY */}

            <TextField
              fullWidth
              type="number"
              label="Quantity"
              value={item.qty}
              onChange={(event) =>
                setItem(
                  (previous) => ({
                    ...previous,
                    qty:
                      event.target.value,
                  })
                )
              }
              inputProps={{
                min: 1,
                step: 1,
              }}
            />

            {/* RATE */}

            <TextField
              fullWidth
              type="number"
              label="Rate"
              value={item.rate}
              onChange={(event) =>
                setItem(
                  (previous) => ({
                    ...previous,
                    rate:
                      event.target.value,
                  })
                )
              }
              inputProps={{
                min: 0,
                step: 0.01,
              }}
            />

            {/* DISCOUNT % */}

            <TextField
              fullWidth
              type="number"
              label="Discount %"
              value={
                item.discount_percent
              }
              onChange={(event) =>
                setItem(
                  (previous) => ({
                    ...previous,
                    discount_percent:
                      event.target.value,
                  })
                )
              }
              inputProps={{
                min: 0,
                max: 100,
                step: 0.01,
              }}
            />

            {/* ITEM TAX % */}

            <TextField
              fullWidth
              type="number"
              label="Tax %"
              value={
                item.tax_percent
              }
              onChange={(event) =>
                setItem(
                  (previous) => ({
                    ...previous,
                    tax_percent:
                      event.target.value,
                  })
                )
              }
              inputProps={{
                min: 0,
                max: 100,
                step: 0.01,
              }}
            />

            {/* ADD BUTTON */}

            <Box
              sx={{
                display: "flex",
                alignItems: "center",
              }}
            >
              <Button
                fullWidth
                variant="contained"
                size="large"
                startIcon={
                  <AddShoppingCartIcon />
                }
                onClick={
                  handleAddItem
                }
              >
                Add Item
              </Button>
            </Box>
          </Box>
        </CardContent>
      </Card>

      {/* =================================================
          SALE ITEMS
      ================================================= */}

      <Card sx={{ mb: 2 }}>
        <CardContent>
          <Typography
            variant="h6"
            fontWeight={700}
            sx={{ mb: 2 }}
          >
            Sale Items
          </Typography>

          {items.length === 0 ? (
            <Typography
              color="text.secondary"
            >
              No items added.
            </Typography>
          ) : (
            <Box
              sx={{
                display: "flex",
                flexDirection:
                  "column",
                gap: 1,
              }}
            >
              {items.map(
                (
                  currentItem,
                  index
                ) => (
                  <Box
                    key={index}
                    sx={{
                      p: 2,
                      border:
                        "1px solid",
                      borderColor:
                        "divider",
                      borderRadius: 2,
                    }}
                  >
                    <Box
                      sx={{
                        display:
                          "grid",
                        gridTemplateColumns:
                          {
                            xs: "1fr",
                            md:
                              "2fr 1fr 1fr 1fr 1fr 1fr auto",
                          },
                        gap: 2,
                        alignItems:
                          "center",
                      }}
                    >
                      <Box>
                        <Typography
                          fontWeight={
                            700
                          }
                        >
                          {
                            currentItem.product_name
                          }
                        </Typography>

                        <Typography
                          variant="body2"
                          color="text.secondary"
                        >
                          SKU:{" "}
                          {
                            currentItem.sku
                          }
                        </Typography>

                        <Typography
                          variant="body2"
                          color="text.secondary"
                        >
                          {
                            currentItem.color_name
                          }{" "}
                          /{" "}
                          {
                            currentItem.size_name
                          }
                        </Typography>
                      </Box>

                      <Typography>
                        Qty:{" "}
                        {
                          currentItem.qty
                        }
                      </Typography>

                      <Typography>
                        Rate: ₹
                        {Number(
                          currentItem.rate
                        ).toFixed(
                          2
                        )}
                      </Typography>

                      <Typography>
                        Discount:{" "}
                        {Number(
                          currentItem.discount_percent
                        ).toFixed(
                          2
                        )}
                        %
                      </Typography>

                      <Typography>
                        Tax:{" "}
                        {Number(
                          currentItem.tax_percent
                        ).toFixed(
                          2
                        )}
                        %
                      </Typography>

                      <Typography
                        fontWeight={700}
                      >
                        ₹
                        {Number(
                          currentItem.amount
                        ).toFixed(
                          2
                        )}
                      </Typography>

                      <Button
                        color="error"
                        size="small"
                        onClick={() =>
                          handleRemoveItem(
                            index
                          )
                        }
                      >
                        Remove
                      </Button>
                    </Box>
                  </Box>
                )
              )}
            </Box>
          )}
        </CardContent>
      </Card>

      {/* =================================================
          SUMMARY
      ================================================= */}

      <Card>
        <CardContent>
          <Box
            sx={{
              maxWidth: 500,
              ml: "auto",
            }}
          >
            <Typography
              variant="h6"
              fontWeight={700}
              sx={{ mb: 2 }}
            >
              Summary
            </Typography>

            <Box
              sx={{
                display: "flex",
                justifyContent:
                  "space-between",
                mb: 1,
              }}
            >
              <Typography>
                Subtotal
              </Typography>

              <Typography fontWeight={700}>
                ₹
                {subtotal.toFixed(
                  2
                )}
              </Typography>
            </Box>

            <Box
              sx={{
                display: "flex",
                justifyContent:
                  "space-between",
                mb: 1,
              }}
            >
              <Typography>
                Discount
              </Typography>

              <Typography>
                ₹
                {totalDiscount.toFixed(
                  2
                )}
              </Typography>
            </Box>

            <Box
              sx={{
                display: "flex",
                justifyContent:
                  "space-between",
                mb: 1,
              }}
            >
              <Typography>
                {taxType}{" "}
                {Number(
                  taxPercent
                ).toFixed(2)}
                %
              </Typography>

              <Typography>
                ₹
                {totalTax.toFixed(
                  2
                )}
              </Typography>
            </Box>

            <Divider sx={{ my: 2 }} />

            <Box
              sx={{
                display: "flex",
                justifyContent:
                  "space-between",
                alignItems:
                  "center",
              }}
            >
              <Typography
                variant="h6"
                fontWeight={700}
              >
                Grand Total
              </Typography>

              <Typography
                variant="h6"
                fontWeight={700}
              >
                ₹
                {grandTotal.toFixed(
                  2
                )}
              </Typography>
            </Box>

            <Button
              fullWidth
              variant="contained"
              size="large"
              startIcon={
                <SaveIcon />
              }
              onClick={
                handleSaveSale
              }
              disabled={
                saving ||
                items.length === 0
              }
              sx={{ mt: 2 }}
            >
              {saving
                ? "Saving..."
                : "Save Sale"}
            </Button>
          </Box>
        </CardContent>
      </Card>

      {/* =================================================
          INVOICE PREVIEW
      ================================================= */}

      <Dialog
        open={invoiceOpen}
        onClose={() =>
          setInvoiceOpen(false)
        }
        fullWidth
        maxWidth="lg"
      >
        <DialogTitle
          sx={{
            display: "flex",
            justifyContent: "space-between",
            alignItems: "center",
          }}
        >
          Invoice Preview

          <Button
            size="small"
            startIcon={<CloseIcon />}
            onClick={() =>
              setInvoiceOpen(false)
            }
          >
            Close
          </Button>
        </DialogTitle>

        <DialogContent dividers>
          {savedInvoice && (
            <Box
              sx={{
                maxWidth: 1000,
                mx: "auto",
                p: { xs: 1, md: 3 },
                border: "1px solid",
                borderColor: "divider",
                borderRadius: 1,
                bgcolor: "background.paper",
              }}
            >
              <Box
                sx={{
                  display: "flex",
                  justifyContent: "space-between",
                  gap: 3,
                  borderBottom: "2px solid",
                  borderColor: "text.primary",
                  pb: 2,
                }}
              >
                <Box>
                  {savedInvoice.company?.logo && (
                    <Box
                      component="img"
                      src={
                        savedInvoice.company.logo.startsWith(
                          "http"
                        )
                          ? savedInvoice.company.logo
                          : `${API_BASE_URL}/${savedInvoice.company.logo.replace(
                              /^\//,
                              ""
                            )}`
                      }
                      alt="Company Logo"
                      sx={{
                        maxWidth: 120,
                        maxHeight: 70,
                        objectFit: "contain",
                        mb: 1,
                      }}
                    />
                  )}

                  <Typography
                    variant="h5"
                    fontWeight={700}
                  >
                    {savedInvoice.company?.company_name ||
                      "MyBusinessAI"}
                  </Typography>

                  <Typography variant="body2">
                    {[
                      savedInvoice.company?.address1,
                      savedInvoice.company?.address2,
                      savedInvoice.company?.city,
                      savedInvoice.company?.state,
                      savedInvoice.company?.pincode,
                    ]
                      .filter(Boolean)
                      .join(", ")}
                  </Typography>

                  {savedInvoice.company?.gst_no && (
                    <Typography variant="body2">
                      GSTIN:{" "}
                      {savedInvoice.company.gst_no}
                    </Typography>
                  )}
                </Box>

                <Box
                  sx={{
                    textAlign: "right",
                  }}
                >
                  <Typography
                    variant="h4"
                    fontWeight={700}
                  >
                    TAX INVOICE
                  </Typography>

                  <Typography>
                    Invoice No:{" "}
                    {savedInvoice.invoice_no ||
                      savedInvoice.sale_no}
                  </Typography>

                  <Typography>
                    Date:{" "}
                    {savedInvoice.sale_date}
                  </Typography>

                  <Typography>
                    Tax:{" "}
                    {savedInvoice.tax_type}{" "}
                    {Number(
                      savedInvoice.tax_percent || 0
                    ).toFixed(2)}
                    %
                  </Typography>
                </Box>
              </Box>

              <Box
                sx={{
                  display: "grid",
                  gridTemplateColumns: {
                    xs: "1fr",
                    md: "1fr 1fr",
                  },
                  gap: 2,
                  mt: 2,
                }}
              >
                {[
                  [
                    "Bill To",
                    savedInvoice.bill_to_customer,
                  ],
                  [
                    "Ship To",
                    savedInvoice.ship_to_customer,
                  ],
                ].map(
                  ([title, customer]) => (
                    <Box
                      key={title}
                      sx={{
                        border: "1px solid",
                        borderColor: "divider",
                        p: 2,
                        borderRadius: 1,
                      }}
                    >
                      <Typography
                        fontWeight={700}
                        sx={{ mb: 1 }}
                      >
                        {title}
                      </Typography>

                      <Typography fontWeight={600}>
                        {customer?.customer_name ||
                          "-"}
                      </Typography>

                      {customer?.gst_no && (
                        <Typography
                          variant="body2"
                        >
                          GSTIN:{" "}
                          {customer.gst_no}
                        </Typography>
                      )}

                      <Typography
                        variant="body2"
                        color="text.secondary"
                      >
                        {getCustomerAddress(
                          customer
                        )}
                      </Typography>

                      {customer?.mobile && (
                        <Typography
                          variant="body2"
                        >
                          Mobile:{" "}
                          {customer.mobile}
                        </Typography>
                      )}
                    </Box>
                  )
                )}
              </Box>

              <Box
                sx={{
                  overflowX: "auto",
                  mt: 3,
                }}
              >
                <Box
                  component="table"
                  sx={{
                    width: "100%",
                    borderCollapse:
                      "collapse",
                    "& th, & td": {
                      border: "1px solid",
                      borderColor:
                        "divider",
                      p: 1,
                      fontSize: 13,
                    },
                    "& th": {
                      bgcolor:
                        "action.hover",
                      fontWeight: 700,
                    },
                  }}
                >
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>Product</th>
                      <th>Qty</th>
                      <th>Rate</th>
                      <th>Discount %</th>
                      <th>Discount</th>
                      <th>Tax %</th>
                      <th>Amount</th>
                    </tr>
                  </thead>

                  <tbody>
                    {savedInvoice.items?.map(
                      (
                        invoiceItem,
                        index
                      ) => (
                        <tr
                          key={index}
                        >
                          <td>
                            {index + 1}
                          </td>

                          <td>
                            <strong>
                              {
                                invoiceItem.product_name
                              }
                            </strong>

                            <br />

                            <Typography
                              component="span"
                              variant="caption"
                              color="text.secondary"
                            >
                              SKU:{" "}
                              {
                                invoiceItem.sku
                              }{" "}
                              |{" "}
                              {
                                invoiceItem.color_name
                              }{" "}
                              /{" "}
                              {
                                invoiceItem.size_name
                              }
                            </Typography>
                          </td>

                          <td>
                            {invoiceItem.qty}
                          </td>

                          <td>
                            ₹
                            {formatMoney(
                              invoiceItem.rate
                            )}
                          </td>

                          <td>
                            {Number(
                              invoiceItem.discount_percent ||
                                0
                            ).toFixed(2)}
                            %
                          </td>

                          <td>
                            ₹
                            {formatMoney(
                              invoiceItem.discount_amount
                            )}
                          </td>

                          <td>
                            {Number(
                              invoiceItem.tax_percent ||
                                0
                            ).toFixed(2)}
                            %
                          </td>

                          <td>
                            ₹
                            {formatMoney(
                              invoiceItem.amount
                            )}
                          </td>
                        </tr>
                      )
                    )}
                  </tbody>
                </Box>
              </Box>

              <Box
                sx={{
                  maxWidth: 400,
                  ml: "auto",
                  mt: 3,
                }}
              >
                {[
                  [
                    "Subtotal",
                    savedInvoice.subtotal,
                  ],
                  [
                    "Discount",
                    savedInvoice.discount,
                  ],
                  [
                    `${savedInvoice.tax_type || "GST"} Tax`,
                    savedInvoice.tax,
                  ],
                  [
                    "Grand Total",
                    savedInvoice.grand_total,
                  ],
                ].map(
                  ([label, value], index) => (
                    <Box
                      key={label}
                      sx={{
                        display: "flex",
                        justifyContent:
                          "space-between",
                        py: 0.7,
                        borderTop:
                          index === 3
                            ? "2px solid"
                            : "none",
                        borderColor:
                          "divider",
                        fontWeight:
                          index === 3
                            ? 700
                            : 400,
                      }}
                    >
                      <Typography
                        fontWeight={
                          index === 3
                            ? 700
                            : 400
                        }
                      >
                        {label}
                      </Typography>

                      <Typography
                        fontWeight={
                          index === 3
                            ? 700
                            : 400
                        }
                      >
                        ₹
                        {formatMoney(
                          value
                        )}
                      </Typography>
                    </Box>
                  )
                )}
              </Box>

              {savedInvoice.company
                ?.terms_conditions && (
                <Box
                  sx={{
                    mt: 3,
                    p: 2,
                    border: "1px solid",
                    borderColor:
                      "divider",
                    borderRadius: 1,
                  }}
                >
                  <Typography
                    fontWeight={700}
                    sx={{ mb: 0.5 }}
                  >
                    Terms & Conditions
                  </Typography>

                  <Typography
                    variant="body2"
                    color="text.secondary"
                  >
                    {
                      savedInvoice
                        .company
                        .terms_conditions
                    }
                  </Typography>
                </Box>
              )}
            </Box>
          )}
        </DialogContent>

        <DialogActions>
          <Button
            onClick={() =>
              setInvoiceOpen(false)
            }
          >
            Close
          </Button>

          <Button
            variant="contained"
            startIcon={
              <PrintIcon />
            }
            onClick={
              printInvoice
            }
            disabled={!savedInvoice}
          >
            Print / PDF
          </Button>
        </DialogActions>
      </Dialog>


      {/* =================================================
          ERROR
      ================================================= */}

      <Snackbar
        open={Boolean(error)}
        autoHideDuration={7000}
        onClose={() =>
          setError("")
        }
        anchorOrigin={{
          vertical: "bottom",
          horizontal: "center",
        }}
      >
        <Alert
          severity="error"
          onClose={() =>
            setError("")
          }
        >
          {error}
        </Alert>
      </Snackbar>

      {/* =================================================
          SUCCESS
      ================================================= */}

      <Snackbar
        open={Boolean(success)}
        autoHideDuration={5000}
        onClose={() =>
          setSuccess("")
        }
        anchorOrigin={{
          vertical: "bottom",
          horizontal: "center",
        }}
      >
        <Alert
          severity="success"
          onClose={() =>
            setSuccess("")
          }
        >
          {success}
        </Alert>
      </Snackbar>
    </Box>
  );
}